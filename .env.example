# Database Configuration
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_GRAPH_NAME=repocompass_brain
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_SSL=false
FALKORDB_TIMEOUT=5

# Server & Network Configuration
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173
DEVELOPMENT_FIXTURES=false
CHAT_MODE=retrieval

# LLM Provider Configuration
# Supported: deterministic | groq | gemini | openrouter | ollama | anthropic | openai
# Default is 'deterministic' (requires zero API keys, zero network, 100% free and grounded)
LLM_PROVIDER=deterministic
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT=20

# Generic API Key (can be used for any provider)
LLM_API_KEY=

# Provider-Specific API Keys (Zero-cost free tiers available where applicable)
# Groq: Free tier with rate limits (e.g., llama-3.1-8b-instant)
GROQ_API_KEY=

# Google Gemini: Free tier via Google AI Studio (e.g., gemini-1.5-flash)
# Notice: Free-tier data may be reviewed/used to improve Google products per terms
GEMINI_API_KEY=

# OpenRouter: Meta-router supporting free models (e.g., openrouter/free)
OPENROUTER_API_KEY=

# Commercial/Paid Providers (Not enabled by default; requires paid credits/billing)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Local Ollama Configuration (Zero API key needed; requires local Ollama instance)
# To use: LLM_PROVIDER=ollama, LLM_BASE_URL=http://localhost:11434/v1, LLM_MODEL=llama3.2
